---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Problema from "../components/Problema.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Tools from "../components/Tools.astro";
import ComoRodar from "../components/ComoRodar.astro";
import Footer from "../components/Footer.astro";

const title = "revisor-notas-mcp: revisão de notas SOAP num LLM local";
const description =
  "Servidor MCP open source que confere notas clínicas no formato SOAP: regras determinísticas mais checagem de coerência por LLM local. Roda inteiramente na sua máquina, o texto da nota não sai dela. Um projeto IA.med. Não é apoio à decisão clínica.";
---

<Layout title={title} description={description}>
  <main>
    <Hero />
    <Disclaimer />
    <Problema />
    <ComoFunciona />
    <Tools />
    <ComoRodar />
  </main>
  <Footer />
</Layout>
